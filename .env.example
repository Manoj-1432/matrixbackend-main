APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use http:// here. `php artisan serve` has no TLS — https:// in the browser causes “invalid response”.
APP_URL=http://127.0.0.1:8000

# Next.js / SPA — comma-separated; required for credentialed API calls (cookies + Sanctum)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional single PCRE (with delimiters) for extra Origins, e.g. preview deploys
# CORS_ALLOWED_ORIGIN_PATTERN=
CORS_SUPPORTS_CREDENTIALS=true

# Stripe Checkout success/cancel redirects (also accepts legacy FRONTEND_URL)
WORKATMO_FRONTEND_URL=http://localhost:3000

# Backend root page — “Developed by” link (set to your company Instagram profile)
WORKATMO_INSTAGRAM_URL=https://www.instagram.com/workatmo_technologies_pvt_ltd/
# Digits only, with country code (e.g. India 91 + 9392599067 → 919392599067)
WORKATMO_WHATSAPP_PHONE=919392599067
WORKATMO_WHATSAPP_MESSAGE=Hi from Matrix Backend API

# Cookie / SPA auth across subdomains (comma-separated, no https://). Example:
# SANCTUM_STATEFUL_DOMAINS=matrixmobiletyresandautos.com,www.matrixmobiletyresandautos.com,api.matrixmobiletyresandautos.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Local: 127.0.0.1. Hostinger / many shared hosts: use `localhost` (socket); check hPanel → Databases if unsure.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=matrix_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: set true so session cookies are not sent over plain HTTP.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin users live in the `users` table only. After RbacSeeder, create the first account:
# php artisan admin:create-user admin@example.com
# (omit --password to enter it interactively; on hosts without Tinker, use --password=...)
